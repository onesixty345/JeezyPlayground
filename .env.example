# Copy these into your Vercel project's Environment Variables
# (Project Settings -> Environment Variables). Never commit real values.

# Full Firebase service-account JSON, pasted as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account", "...": "..."}

# Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# Shared secret clients must send as the x-api-key header
API_KEY=
